# config.env — edite e rode ./pmmp restart
# Obs: SERVER_NAME, PORT, MAX_PLAYERS etc. só são usados na CRIAÇÃO do server/server.properties.
# Depois disso, edite server/server.properties direto (ou apague-o para regenerar).

# --- binários ---
PHP_VERSION="8.4"          # 8.2 | 8.3 | 8.4 | 8.5
PM_VERSION="latest"        # "latest" ou uma tag, ex: 5.44.3

# --- servidor (valores iniciais do server.properties) ---
SERVER_NAME="PocketMine Termux"
SERVER_PORT="19132"        # UDP
MAX_PLAYERS="8"
VIEW_DISTANCE="6"          # celular: mantenha baixo (4-8)
GAMEMODE="survival"
DIFFICULTY="normal"
XBOX_AUTH="on"             # "off" deixa entrar sem conta Xbox (inseguro na internet)
ENABLE_IPV6="off"
LANGUAGE="eng"

# --- execução ---
AUTO_RESTART="1"           # reinicia se o servidor cair (para após 3 quedas em <30s)
BACKUP_KEEP="5"

# --- playit (acesso pela internet sem abrir porta no roteador) ---
USE_PLAYIT="1"
PLAYIT_VERSION="v1.0.10"   # "latest" arrisca mudança de CLI
PLAYIT_WRAPPER="proot"     # "proot" (padrão no Termux) ou "none"
